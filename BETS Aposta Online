-- FUNÇÃO PRINCIPAL DE CONFIRMAÇÃO E CORREÇÃO DO BUG
local function HandleMediaConfirmation()
    if isSendingMedia or not isIdValidForSending then -- BLOQUEIO SE JÁ ESTIVER ENVIANDO OU SE O ID FOR INVÁLIDO
        -- Adiciona feedback visual se tentar enviar inválido
        if not isIdValidForSending then
            IdTextBox.PlaceholderText = "ID inválido. Não é possível confirmar."
            task.delay(2, function()
                 IdTextBox.PlaceholderText = "Insira o ID de "..selectedMediaType.." (apenas números)"
            end)
        end
        return
    end
    
    -- Para o áudio de preview antes de enviar
    if previewSound and isPreviewPlaying then
        previewSound:Stop()
        isPreviewPlaying = false
    end

    local id = IdTextBox.Text:gsub("%D", "") -- Filtra e mantém apenas dígitos (IDs são numéricos)
    
    isSendingMedia = true
    PanelTitle.Text = "Enviando..."
    IdTextBox.Visible = false
    PreviewContainer.Visible = false
    ActionFrame.Visible = false
    
    local dados = {}
    if selectedMediaType == "Audio" then
        dados.AudioId = id 
    elseif selectedMediaType == "Imagem" then
        dados.ImageId = id 
    else
        warn("Erro de tipo de mídia desconhecido:", selectedMediaType)
        isSendingMedia = false
        ConfirmarButton.Text = "Confirmar"
        return
    end
    
    -- Envia a mensagem com o tipo de mídia e os dados específicos
    local result = SendMessagePayload(selectedMediaType, dados)
    
    if result == "Sucesso" then
        CloseMediaPanel() -- Fecha o painel após o envio
    end
    
    isSendingMedia = false
    ConfirmarButton.Text = "Confirmar"
end


