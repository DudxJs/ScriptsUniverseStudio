-- ==========================================================
-- MINI PAINEL REUTILIZÁVEL (CORRIGIDO: BLOQUEIO FORÇADO DO TEXTBOX)
-- ==========================================================
local function CriarMiniPainel(titulo, linhas)
	local painel = Instance.new("ScrollingFrame")
	painel.Name = "MiniPainel"
	painel.Size = UDim2.new(0, 240, 0, 10)
	painel.AutomaticSize = Enum.AutomaticSize.Y
	painel.Position = UDim2.new(0.5, 0, 1.5, 0)
	painel.AnchorPoint = Vector2.new(0.5, 0.5)
	painel.BackgroundColor3 = COR_SUPERFICIE:Lerp(Color3.new(0,0,0), 0.1)
	painel.BorderSizePixel = 0
	painel.Visible = true
	painel.ZIndex = 10
	painel.Parent = Frame
	painel.ScrollBarThickness = 6
	painel.CanvasSize = UDim2.new(0, 0, 0, 0)
	painel.AutomaticCanvasSize = Enum.AutomaticSize.Y
	painel.ClipsDescendants = true

    -- Array para rastrear e controlar elementos
    local elementosControlados = {} 
    
    -- Cores para o estado de bloqueio 
    local COR_BLOQUEADA = COR_TEXTO:Lerp(Color3.new(0,0,0), 0.5) 
    local COR_FUNDO_BLOQUEADO = Color3.fromRGB(40, 40, 40) 


	-- Limite de altura
	local MAX_HEIGHT = 260
	painel:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(function()
		if painel.AbsoluteCanvasSize.Y > MAX_HEIGHT then
			painel.AutomaticSize = Enum.AutomaticSize.None
			painel.Size = UDim2.new(0, 240, 0, MAX_HEIGHT)
		end
	end)

	local UICorner = Instance.new("UICorner", painel)
	UICorner.CornerRadius = UDim.new(0, RAIO_CANTO_PEQUENO)

	-- Layout principal
	local layout = Instance.new("UIListLayout", painel)
	layout.Padding = UDim.new(0, 5)
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder

	local UIPadding_Panel = Instance.new("UIPadding", painel)
	UIPadding_Panel.PaddingTop = UDim.new(0, 5)
	UIPadding_Panel.PaddingBottom = UDim.new(0, 5)

	-- Animação de entrada
    painel.BackgroundTransparency = 1
	painel.Transparency = 1
	TweenService:Create(painel, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 0.5, 0),
		BackgroundTransparency = 0,
		Transparency = 0
	}):Play()

	-- Função de fechar
	local function FecharPainel()
		TweenService:Create(painel, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, 0, 1.5, 0),
			BackgroundTransparency = 1,
			Transparency = 1
		}):Play()
		task.delay(0.3, function() painel:Destroy() end)
	end

	-- Função para Limpar o Conteúdo do Painel e redefinir o título
    local function LimparConteudo(novoTitulo)
        for _, child in ipairs(painel:GetChildren()) do
            if child:IsA("Frame") or (child:IsA("TextLabel") and child.LayoutOrder ~= 0) or child:IsA("TextButton") then
                child:Destroy()
            end
        end

		local tituloLbl = painel:FindFirstChild("PanelTitle")
		
		if not tituloLbl then
			tituloLbl = Instance.new("TextLabel", painel)
			tituloLbl.Name = "PanelTitle" 
			tituloLbl.Size = UDim2.new(1, -20, 0, 30)
			tituloLbl.TextColor3 = COR_TEXTO
			tituloLbl.BackgroundTransparency = 1
			tituloLbl.Font = Enum.Font.SourceSansBold
			tituloLbl.TextSize = 20
			tituloLbl.ZIndex = 11
			tituloLbl.LayoutOrder = 0 
		end
		
        tituloLbl.Text = novoTitulo or "Painel"
        
        painel.AutomaticSize = Enum.AutomaticSize.None 
        painel.Size = UDim2.new(0, 240, 0, 40) 
        
        painel.AutomaticCanvasSize = Enum.AutomaticSize.Y
        painel.CanvasSize = UDim2.new(0, 0, 0, 0)
        
        local originalSortOrder = layout.SortOrder
        layout.SortOrder = Enum.SortOrder.Name 
        layout.SortOrder = originalSortOrder 
        
        painel.AutomaticSize = Enum.AutomaticSize.Y
    end
    
    LimparConteudo(titulo)

    -- NOVO: Função para bloquear/desbloquear todos os elementos controlados
    local function BloquearElementos(deveBloquear)
        
        for _, itemData in ipairs(elementosControlados) do
            local obj = itemData.Obj
            local tipo = itemData.Tipo
            local corOriginalTexto = itemData.CorOriginal or COR_TEXTO 

            if tipo == "Botao" then
                -- Botão: Desativa e escurece o fundo
                obj.Active = not deveBloquear
                obj.BackgroundColor3 = deveBloquear and COR_FUNDO_BLOQUEADO or itemData.CorOriginalFundo 
                obj.TextColor3 = deveBloquear and COR_BLOQUEADA or Color3.new(1,1,1)

            elseif tipo == "TextBox" then
                local Hitbox = itemData.ObjHitbox
                
                -- CORREÇÃO FINAL: BLOQUEIO TRIPLO E SEGURO:
                Hitbox.Active = deveBloquear          -- 1. Hitbox (ZIndex 20): Captura cliques/toques
                obj.Selectable = not deveBloquear     -- 2. Selectable: Impede foco via Tab
                obj.TextEditable = not deveBloquear   -- 3. TextEditable: Impede input de texto
                
                -- Controle Visual
                local targetColor = deveBloquear and COR_BLOQUEADA or corOriginalTexto
                obj.TextColor3 = targetColor
                obj.PlaceholderColor3 = targetColor

            elseif tipo == "Switch" then
                -- Switch: Desativa Hitbox e escurece ambos os textos
                itemData.ObjHitbox.Active = not deveBloquear
                
                local targetColor = deveBloquear and COR_BLOQUEADA or corOriginalTexto
                
                -- Label
                itemData.ObjSwitchLabel.TextColor3 = targetColor

                -- CheckBox
                if deveBloquear then
                    itemData.ObjCheckBox.TextColor3 = COR_BLOQUEADA
                else
                    local isAtivo = itemData.ObjCheckBox.Text == "[☑️]"
                    itemData.ObjCheckBox.TextColor3 = isAtivo and COR_DESTAQUE or corOriginalTexto
                end
                
            elseif tipo == "Texto" or tipo == "Subtitulo" then
                -- Textos/Subtítulos: Apenas escurece o texto
                obj.TextColor3 = deveBloquear and COR_BLOQUEADA or corOriginalTexto
            end
        end
    end
    
	-- Define o objeto de controle que será retornado
    local controlObject = {
        painel = painel, 
        Fechar = FecharPainel, 
        Limpar = LimparConteudo,
        Bloquear = BloquearElementos 
    }


	-- Criação das linhas 
	local ordem = 1 
    
	for _, linha in ipairs(linhas) do
		local linhaFrame = Instance.new("Frame", painel)
		linhaFrame.Size = UDim2.new(1, -10, 0, 40)
		linhaFrame.BackgroundTransparency = 1
		linhaFrame.LayoutOrder = ordem
		ordem += 1

		local linhaLayout = Instance.new("UIListLayout", linhaFrame)
		linhaLayout.FillDirection = Enum.FillDirection.Horizontal
		linhaLayout.Padding = UDim.new(0, 5)
		linhaLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

		local tiposUsados = {}
		for _, item in ipairs(linha) do
			local tipo, texto, callback = item.Tipo, item.Texto or "", item.Funcao

			if tipo == "Botao" then
				local botao = Instance.new("TextButton", linhaFrame)
				botao.Size = UDim2.new(0.5, -5, 1, 0)
				botao.Text = texto
				botao.BackgroundColor3 = COR_BOTAO_PRIMARIO
				botao.TextColor3 = Color3.new(1,1,1)
				botao.Font = Enum.Font.SourceSansBold
				botao.TextSize = 16
				botao.ZIndex = 11
				local u = Instance.new("UICorner", botao)
				u.CornerRadius = UDim.new(0, 8)
				if callback then
					botao.MouseButton1Click:Connect(function()
						callback(controlObject) 
					end)
				end
                table.insert(elementosControlados, {Obj = botao, Tipo = "Botao", CorOriginalFundo = COR_BOTAO_PRIMARIO})


			elseif not tiposUsados[tipo] then
				tiposUsados[tipo] = true
				if tipo == "TextBox" then
					
					local TextBoxContainer = Instance.new("Frame", linhaFrame)
					TextBoxContainer.Size = UDim2.new(1, -10, 1, 0) 
					TextBoxContainer.BackgroundTransparency = 1
					
					local box = Instance.new("TextBox", TextBoxContainer)
					box.Size = UDim2.new(1, 0, 1, 0) 
					box.PlaceholderText = texto
					box.BackgroundColor3 = COR_FUNDO_PRINCIPAL
					box.TextColor3 = COR_TEXTO
					box.Font = Enum.Font.SourceSans
					box.Text = ""
					box.TextSize = 16
					box.ZIndex = 11 
					box.ClearTextOnFocus = false
                    box.Selectable = true -- Inicia selecionável
                    box.TextEditable = true -- NOVO: Inicia editável
					local u = Instance.new("UICorner", box)
					u.CornerRadius = UDim.new(0, 8)
                    
                    local Hitbox = Instance.new("TextButton", TextBoxContainer)
                    Hitbox.Name = "Hitbox"
                    Hitbox.Size = UDim2.new(1, 0, 1, 0) 
                    Hitbox.Position = UDim2.new(0, 0, 0, 0)
                    Hitbox.BackgroundTransparency = 1
                    Hitbox.Text = "" 
                    Hitbox.ZIndex = 20 
                    Hitbox.Active = false 
                    
                    Hitbox.MouseButton1Click:Connect(function() 
                        if Hitbox.Active then 
                            box:ReleaseFocus()
                        end
                    end)
                    
                    -- Removendo box.Focused:Connect
                    -- box.Focused:Connect(function()
                    --    if Hitbox.Active then
                    --        box:ReleaseFocus()
                    --    end
                    -- end)

                    table.insert(elementosControlados, {Obj = box, Tipo = "TextBox", CorOriginal = COR_TEXTO, ObjHitbox = Hitbox})


				elseif tipo == "Subtitulo" then
					local lbl = Instance.new("TextLabel", linhaFrame)
					lbl.Size = UDim2.new(1, -10, 0, 25)
					lbl.Text = texto
					lbl.TextColor3 = Color3.fromRGB(220, 220, 220) 
					lbl.BackgroundTransparency = 1
					lbl.TextXAlignment = Enum.TextXAlignment.Left
					lbl.Font = Enum.Font.SourceSansBold
					lbl.TextSize = 16
					lbl.ZIndex = 11
                    table.insert(elementosControlados, {Obj = lbl, Tipo = "Subtitulo", CorOriginal = Color3.fromRGB(220, 220, 220)})

				elseif tipo == "Texto" then
					local lbl = Instance.new("TextLabel", linhaFrame)
					lbl.Size = UDim2.new(1, -10, 0, 25)
					lbl.Text = texto
					lbl.TextColor3 = Color3.fromRGB(255, 255, 255) 
					lbl.BackgroundTransparency = 1
					lbl.TextXAlignment = Enum.TextXAlignment.Center
					lbl.Font = Enum.Font.SourceSans
					lbl.TextSize = 16
					lbl.ZIndex = 11
                    table.insert(elementosControlados, {Obj = lbl, Tipo = "Texto", CorOriginal = Color3.fromRGB(255, 255, 255)})
                    
				elseif tipo == "Switch" then
					
					local isAtivo = item.EstadoInicial or false
					
					local SwitchFrame = Instance.new("Frame", linhaFrame)
					SwitchFrame.Size = UDim2.new(1, -10, 1, 0)
					SwitchFrame.BackgroundTransparency = 1
					SwitchFrame.LayoutOrder = 1 
					
					local CheckBox = Instance.new("TextLabel", SwitchFrame)
					CheckBox.Name = "CheckBox"
					CheckBox.Size = UDim2.new(0, 30, 1, 0) 
					CheckBox.Position = UDim2.new(0, 5, 0, 0) 
					CheckBox.Text = isAtivo and "[☑️]" or "[     ]"
					CheckBox.TextColor3 = isAtivo and COR_DESTAQUE or COR_TEXTO 
					CheckBox.BackgroundTransparency = 1
					CheckBox.Font = Enum.Font.SourceSansBold
					CheckBox.TextSize = 20
					CheckBox.TextXAlignment = Enum.TextXAlignment.Center
					CheckBox.ZIndex = 11 
					
					local SwitchLabel = Instance.new("TextLabel", SwitchFrame)
					SwitchLabel.Name = "SwitchLabel"
					SwitchLabel.Size = UDim2.new(1, -40, 1, 0) 
					SwitchLabel.Position = UDim2.new(0, 35, 0, 0) 
					SwitchLabel.Text = texto
					SwitchLabel.TextColor3 = COR_TEXTO
					SwitchLabel.BackgroundTransparency = 1
					SwitchLabel.TextXAlignment = Enum.TextXAlignment.Left
					SwitchLabel.Font = Enum.Font.SourceSans
					SwitchLabel.TextSize = 16
					SwitchLabel.ZIndex = 11 
					
					local function UpdateSwitch(novoEstado)
						isAtivo = novoEstado
						CheckBox.Text = isAtivo and "[☑️]" or "[     ]"
						CheckBox.TextColor3 = isAtivo and COR_DESTAQUE or COR_TEXTO
					end
					
					local Hitbox = Instance.new("TextButton", SwitchFrame)
					Hitbox.Size = UDim2.new(1, 0, 1, 0)
					Hitbox.Position = UDim2.new(0, 0, 0, 0) 
					Hitbox.BackgroundTransparency = 1
					Hitbox.Text = "" 
					Hitbox.ZIndex = 15 
					
					if callback then
						Hitbox.MouseButton1Click:Connect(function()
                            if Hitbox.Active then 
                                local novoEstado = not isAtivo
                                UpdateSwitch(novoEstado)
                                callback(novoEstado, controlObject) 
                            end
						end)
					end
                    
                    table.insert(elementosControlados, {
                        Tipo = "Switch",
                        ObjHitbox = Hitbox, 
                        ObjCheckBox = CheckBox,
                        ObjSwitchLabel = SwitchLabel,
                        CorOriginal = COR_TEXTO 
                    })
					
				end
			end
		end
	end

	return controlObject
end

