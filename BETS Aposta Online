-- Função auxiliar para atualizar a tela de carregamento (NOVO)
local function UpdateLoadingStatus(status, description, increment)
    if isLoadingCompleted then return end
	
    loadingStatus = loadingStatus + (increment or 0)
    local percentage = math.min(loadingStatus, 100) / 100
    
	if loadingFrame and loadingFrame:FindFirstChild("ProgressBar") then
		local progressBar = loadingFrame.ProgressBar
		local progressFill = progressBar.ProgressFill
		local progressLabel = loadingFrame.ProgressLabel
		local statusLabel = loadingFrame.StatusLabel
		
		-- Anima a barra de progresso
		TweenService:Create(progressFill, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Size = UDim2.new(percentage, 0, 1, 0)
		}):Play()
		
		-- Atualiza o texto de status
		if statusLabel then statusLabel.Text = description end
		if progressLabel then progressLabel.Text = string.format("%d%%", math.floor(percentage * 100)) end
		
		if status >= 100 then
			isLoadingCompleted = true
			statusLabel.Text = "✅ Chat Pronto! Inicializando UI..."
			task.wait(1)
			-- Faz um fade out suave do frame de carregamento
			TweenService:Create(loadingFrame, TweenInfo.new(0.5), {BackgroundTransparency = 1, Transparency = 1}):Play()
			
			-- Destrói o frame de carregamento para liberar interação
			task.delay(0.6, function() 
                if loadingFrame and loadingFrame.Destroy then loadingFrame:Destroy() end
            end)
		end
	end
end

-- Função para carregar as informações do jogador
local function LoadPlayerInfo()
	UpdateLoadingStatus(0, "🌐 Carregando informações de permissão do usuário...", 33) -- NOVO
	
	local success, result = pcall(function()
		local response = http_request({
			Url = url.."?pagina="..INFO_SHEET_NAME,	
			Method = "GET"	
		})
		if not response or not response.Body then return nil end
		return HttpService:JSONDecode(response.Body)
	end)
	
	if success and result and type(result) == "table" then
		local newInfo = {}
		for i, info in ipairs(result) do
			local userId = tonumber(info.UserId)
			local row = i + 1 -- A linha real na planilha (1 + índice i)
			
			if userId then
				newInfo[userId] = {
					Class = (info.Class or "DEFAULT"):upper(),
					PlayerName = info.PlayerName or "Desconhecido",
					TimestampPrimeira = tonumber(info.TimestampPrimeira) or 0,
					IDPrimeiraMensagem = info.IDPrimeiraMensagem or "",
					TimestampUltima = tonumber(info.TimestampUltima) or 0,
					IDUltimaMensagem = info.IDUltimaMensagem or "",
					Row = row,
					Status = (info.Status or "") -- NOVO: Lê a coluna "Status" (ex: "Punido")
				}	
			end
		end
		playerInfo = newInfo
		print(string.format("Informações de %d jogadores carregadas da aba '%s'.", #result, INFO_SHEET_NAME))
		UpdateLoadingStatus(0, "✅ Permissões carregadas. Iniciando download de mensagens...", 33) -- NOVO

		-- Se o próprio jogador estiver marcado como punido, recuperar os detalhes e aplicar ban local
		local myInfo = playerInfo[LocalPlayer.UserId]
		if myInfo and myInfo.Status and myInfo.Status:lower() == "punido" then
			-- Busca no histórico de punições os detalhes e aplica o ban local
			task.spawn(function()
				UpdateLoadingStatus(0, "🔒 Você está punido. Recuperando detalhes...", 0)
				local punicoesSuccess, punicoes = pcall(function()
					local resp = http_request({ Url = url.."?pagina="..PUNICOES_SHEET_NAME, Method = "GET" })
					if not resp or not resp.Body then return nil end
					return HttpService:JSONDecode(resp.Body)
				end)
				if punicoesSuccess and type(punicoes) == "table" then
					-- procura a entrada mais recente para este UserId
					local latest = nil
					for _, p in ipairs(punicoes) do
						if tonumber(p.TargetUserId) == LocalPlayer.UserId then
							latest = p
						end
					end
					if latest then
						-- Aplica ban local baseado nos detalhes encontrados
						-- (função ApplyLocalBan implementada mais abaixo)
						if latest.Motivo or latest.DurationMinutes then
							-- converte Duration
							local banDetails = {
								TargetUserId = tonumber(latest.TargetUserId) or LocalPlayer.UserId,
								TargetName = latest.TargetName or LocalPlayer.Name,
								ModeratorUserId = tonumber(latest.ModeratorUserId) or 0,
								ModeratorName = latest.ModeratorName or "Unknown",
								Motivo = latest.Motivo or "",
								DurationMinutes = tonumber(latest.DurationMinutes) or 0,
								Timestamp = tonumber(latest.Timestamp) or os.time(),
								MessageID = latest.MessageID or ""
							}
							-- Apply
							task.delay(0.1, function()
								-- ApplyLocalBan may not yet be defined; we will check later (declared below)
								if type(ApplyLocalBan) == "function" then
									ApplyLocalBan(banDetails)
								else
									-- Emite uma flag para ser checada mais tarde
									_G.__pending_local_ban = banDetails
								end
							end)
						end
					end
				end
			end)
		end

	else
		warn("Erro ao carregar informações dos jogadores. Usando permissão padrão.")
		UpdateLoadingStatus(0, "⚠️ Erro ao carregar permissões. Usando Padrão.", 33) -- NOVO
	end
end

-- Função para obter o nível de permissão (Mantida)
local function GetPlayerPermissionClass()
	local info = playerInfo[LocalPlayer.UserId]
	return info and info.Class or "DEFAULT"
end

-- Função para obter o cooldown Padrão
local function GetPlayerCooldown()
	local Class = GetPlayerPermissionClass()
	if Class == "DEV" then return DEV_COOLDOWN end
	if Class == "ADM" then return ADM_COOLDOWN end
	if Class == "VIP" then return VIP_COOLDOWN end
	return DEFAULT_COOLDOWN
end

-- Função para verificar se a permissão é suficiente (Mantida)
local function IsPermissionSufficient(requiredClass)
	local playerClass = GetPlayerPermissionClass()
	local requiredOrder = PERMISSION_ORDER[requiredClass:upper()] or 0
	local playerOrder = PERMISSION_ORDER[playerClass:upper()] or 0
	return playerOrder >= requiredOrder
end

-- Função para atualizar a linha do jogador com a última mensagem
local function UpdatePlayerLastMessage(messageId, currentTime)
	local player_id = LocalPlayer.UserId
	local info = playerInfo[player_id]
	
	if info and info.Row then
		-- JOGADOR EXISTENTE: SOBRESCREVE a célula UltimaMensagem (Timestamp e ID)
		
		local valuesToWrite = {{currentTime, messageId}} -- {{Timestamp, ID}}
		local startCol = TIMESTAMP_ULTIMA_COL -- Coluna F
		local numCols = 2 -- Escreve nas colunas F e G
		
		-- Atualiza SOMENTE as colunas de Última Mensagem
		local success = EscreverCelula(
			INFO_SHEET_NAME,	
			info.Row,	
			startCol,	
			valuesToWrite	
		)
		
		-- Se for a primeira vez que o jogador envia uma mensagem (mas já tinha registro de Class)
		-- Devemos sobrescrever também os campos de Primeira Mensagem
		if info.TimestampPrimeira == 0 then
			-- Sobrescreve nas colunas de Primeira Mensagem (D e E)
			EscreverCelula(
				INFO_SHEET_NAME,	
				info.Row,	
				TIMESTAMP_PRIMEIRA_COL,	
				valuesToWrite
			)
		end
		
		if success then
			-- Atualiza o cache local
			playerInfo[player_id].TimestampUltima = currentTime
			playerInfo[player_id].IDUltimaMensagem = messageId
			if playerInfo[player_id].TimestampPrimeira == 0 then
				 playerInfo[player_id].TimestampPrimeira = currentTime
				 playerInfo[player_id].IDPrimeiraMensagem = messageId
			end
		else
			warn("Falha ao atualizar a UltimaMensagem e ID para o UserId:", player_id)
		end
	else
		-- NOVO JOGADOR: Envia um POST completo para CRIAR uma nova linha (appendRow no Apps Script)
		local payload = {
			pagina = INFO_SHEET_NAME,	
			UserId = player_id,
			PlayerName = LocalPlayer.Name,
			Class = "DEFAULT",
			-- NOVOS CAMPOS: Timestamp e ID para ambas
			TimestampPrimeira = currentTime,
			IDPrimeiraMensagem = messageId,
			TimestampUltima = currentTime,
			IDUltimaMensagem = messageId,
			apikey = API_KEY	
		}

		local success, _ = pcall(function()
			return http_request({
				Url = url,
				Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = HttpService:JSONEncode(payload)
			})
		end)

		if success then
			-- Recarrega a tabela de info em 5s para pegar a nova Row
			task.delay(5, LoadPlayerInfo)	
		else
			warn("Falha ao criar o registro do novo jogador.", player_id)
		end
	end
end

-- [[ FUNÇÕES AUXILIARES (Mantidas) ]]
local function GetInicioDoDia(timestamp)
	if type(timestamp) ~= "number" or timestamp == 0 then return 0 end
	local t = os.date("*t", timestamp)
	return os.time({year=t.year, month=t.month, day=t.day, hour=0, min=0, sec=0})
end
local function GetExperienceNameById(id)
	if experienceNameCache[id] then return experienceNameCache[id] end
	local nome = "Jogo?"
	local success, info = pcall(function()
		return MarketplaceService:GetProductInfo(id, Enum.InfoType.Asset)
	end)
	if success and info and info.Name then nome = info.Name else nome = "Jogo #"..id end
	experienceNameCache[id] = nome
	return nome
end
local function FormatarTempoRelativo(timestampMsg)
	if type(timestampMsg) ~= "number" or timestampMsg == 0 then return "?" end
	local diff = math.max(os.time() - timestampMsg, 0)
	if diff < 60 then return diff.."s"
	elseif diff < 3600 then return math.floor(diff/60).."m"
	elseif diff < 86400 then return math.floor(diff/3600).."h"
	elseif diff < 864000 then return math.floor(diff/86400).."d"
	else return os.date("%d/%m", timestampMsg) end
end
local function GetPlayerThumbnail(userId)
	local content = ""
	pcall(function()
		content = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
	end)
	return content
end
local function FormatarData(timestamp)
	local inicioMsg = GetInicioDoDia(timestamp)
	local inicioHoje = GetInicioDoDia(os.time())
	local inicioOntem = GetInicioDoDia(os.time() - 86400)
	if inicioMsg == inicioHoje then return "Hoje"
	elseif inicioMsg == inicioOntem then return "Ontem"
	else return os.date("%d/%m/%Y", timestamp) end
end

-- NOVO: Função para formatar segundos para M:SS
local function FormatTime(seconds)
    if not seconds or seconds < 0 then return "0:00" end
    local minutes = math.floor(seconds / 60)
    local remainingSeconds = math.floor(seconds % 60)
    return string.format("%d:%02d", minutes, remainingSeconds)
end

