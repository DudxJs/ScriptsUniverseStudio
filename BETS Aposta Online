local function TryDecodeDadosField(dadosField)
	if not dadosField or dadosField == "" then return nil end
	local ok, decoded = pcall(function() return HttpService:JSONDecode(dadosField) end)
	if ok and type(decoded) == "table" then return decoded end
	return nil
end

local function HandleBanPayloadFromMessage(msg)
	if not msg or not msg.Dados then return end
	local parsed = TryDecodeDadosField(msg.Dados)
	if not parsed then return end
	local ban = parsed.Ban
	if not ban then return end

	-- Normaliza tipos
	if ban.TargetUserId then ban.TargetUserId = tonumber(ban.TargetUserId) end
	if ban.DurationMinutes then ban.DurationMinutes = tonumber(ban.DurationMinutes) end
	if ban.Timestamp then ban.Timestamp = tonumber(ban.Timestamp) end

	-- Se o alvo for o LocalPlayer => carregar detalhes da aba Punições e aplicar ban local
	if ban.TargetUserId == LocalPlayer.UserId then
		-- tenta buscar detalhes completos na aba de Punições (garantir consistência)
		task.spawn(function()
			local suc, punicoes = pcall(function()
				local resp = http_request({ Url = url.."?pagina="..PUNICOES_SHEET_NAME, Method = "GET" })
				if not resp or not resp.Body then return nil end
				return HttpService:JSONDecode(resp.Body)
			end)
			if suc and type(punicoes) == "table" then
				-- procura o registro mais recente que bata com MessageID ou TargetUserId
				local matched = nil
				for _, p in ipairs(punicoes) do
					if p.MessageID and p.MessageID == msg.ID then matched = p end
				end
				if not matched then
					for _, p in ipairs(punicoes) do
						if tonumber(p.TargetUserId) == LocalPlayer.UserId then matched = p end
					end
				end
				local banDetails = nil
				if matched then
					banDetails = {
						TargetUserId = tonumber(matched.TargetUserId) or LocalPlayer.UserId,
						TargetName = matched.TargetName or LocalPlayer.Name,
						ModeratorUserId = tonumber(matched.ModeratorUserId) or 0,
						ModeratorName = matched.ModeratorName or "Unknown",
						Motivo = matched.Motivo or ban.Motivo or "Sem motivo",
						DurationMinutes = tonumber(matched.DurationMinutes) or ban.DurationMinutes or 0,
						Timestamp = tonumber(matched.Timestamp) or ban.Timestamp or os.time(),
						MessageID = matched.MessageID or msg.ID
					}
				else
					banDetails = {
						TargetUserId = ban.TargetUserId,
						TargetName = ban.TargetName or "Você",
						ModeratorUserId = ban.ModeratorUserId or 0,
						ModeratorName = ban.ModeratorName or "Unknown",
						Motivo = ban.Motivo or "Sem motivo",
						DurationMinutes = ban.DurationMinutes or 0,
						Timestamp = ban.Timestamp or os.time(),
						MessageID = msg.ID
					}
				end
				ApplyLocalBan(banDetails)
			else
				-- fallback: aplicar ban com o que veio no payload
				local banDetails = {
					TargetUserId = ban.TargetUserId,
					TargetName = ban.TargetName or "Você",
					ModeratorUserId = ban.ModeratorUserId or 0,
					ModeratorName = ban.ModeratorName or "Unknown",
					Motivo = ban.Motivo or "Sem motivo",
					DurationMinutes = ban.DurationMinutes or 0,
					Timestamp = ban.Timestamp or os.time(),
					MessageID = msg.ID
				}
				ApplyLocalBan(banDetails)
			end
		end)
	else
		-- Se for outra pessoa: exibir aviso administrativo no chat (não bloquear)
		local notice = Instance.new("TextLabel", ScrollingFrame)
		notice.Size = UDim2.new(1, -20, 0, 20)
		notice.BackgroundTransparency = 1
		notice.TextColor3 = Color3.fromRGB(255, 170, 0)
		notice.Text = string.format("⚠️ [Mod] %s foi punido por %s", ban.TargetName or "Um jogador", ban.Motivo or "Sem motivo")
		notice.Font = Enum.Font.SourceSansItalic
		notice.TextSize = 14
		notice.LayoutOrder = tonumber(msg.Timestamp) or os.time()
		task.defer(function() ScrollingFrame.CanvasSize = UDim2.new(0,0,0,UIListLayout.AbsoluteContentSize.Y) end)
	end
end

local function AtualizarMensagens(limite, isLoadMore)
	
	if isLoadOldCooldown and isLoadMore then return end
	
	if isLoadMore then
		isLoadOldCooldown = true
		LoadOld.Text = "⏳ Carregando..."
		LoadOld.BackgroundColor3 = Color3.fromRGB(90, 70, 70)
	elseif not isInitialLoadComplete then -- NOVO: Estado de loading inicial
		UpdateLoadingStatus(0, string.format("📥 Baixando %d mensagens iniciais...", limite), 33)
	end
	
	local fetchLimit = limite or MESSAGES_TO_LOAD_INITIAL	

	local success, result = pcall(function()
		local response = http_request({
			Url = url.."?pagina="..DATA_SHEET_NAME, -- ChatGlobal
			Method = "GET"	
		})
		if not response or not response.Body then return nil end
		return HttpService:JSONDecode(response.Body)
	end)
	
	if success and result and type(result) == "table" then
		
		table.sort(result, function(a,b) return tonumber(a.Timestamp) < tonumber(b.Timestamp) end)

		if isLoadMore and #result <= fetchLimit then
			LoadOld.Visible = false
		end
		
		local oldContentSize = UIListLayout.AbsoluteContentSize.Y
		
		local mapaMensagens = {}
		for _, msg in ipairs(result) do mapaMensagens[msg.ID] = msg end

		local novasMensagensAdicionadas = false
		local startIndex = math.max(1, #result - fetchLimit)
		
		for i = startIndex, #result do
			local msg = result[i]
			ProcessarComando(msg)	

			-- DETECÇÃO DE PAYLOAD DE BAN (Se existir, processa antes de criar UI)
			local parsedDados = TryDecodeDadosField(msg.Dados)
			if parsedDados and parsedDados.Ban then
				HandleBanPayloadFromMessage(msg)
			end

			-- Apenas cria a mensagem se ela ainda não foi criada
			if not mensagensCriadas[msg.ID] then
				CriarMensagem(msg, mapaMensagens)
				novasMensagensAdicionadas = true
			end
		end
		
		if novasMensagensAdicionadas then
			UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
			task.wait()	
			ScrollingFrame.CanvasSize = UDim2.new(0,0,0,UIListLayout.AbsoluteContentSize.Y)
			
			local newContentSize = UIListLayout.AbsoluteContentSize.Y
			
			if isLoadMore then
				local diff = newContentSize - oldContentSize
				ScrollingFrame.CanvasPosition = Vector2.new(0, diff)	
			elseif not isInitialLoadComplete then
				-- Scrolla para o final na carga inicial
				ScrollingFrame.CanvasPosition = Vector2.new(0, math.huge)
				isInitialLoadComplete = true
			else
				local scrollDistance = ScrollingFrame.CanvasSize.Y.Offset - ScrollingFrame.AbsoluteSize.Y
				if ScrollingFrame.CanvasPosition.Y >= scrollDistance - 100 then	
					ScrollingFrame.CanvasPosition = Vector2.new(0, math.huge)
				end
			end
		end
	end
	
	if not isLoadMore and not isLoadingCompleted then -- NOVO: Finaliza o Loading Inicial
		UpdateLoadingStatus(100, "✅ Carregamento Concluído!", 33)
		TextBox.TextEditable = true -- Libera o input
		Enviar.Active = true
	end
	
	if isLoadMore then
		isLoadOldCooldown = false
		LoadOld.Text = "🕓 Carregar mais mensagens"
		LoadOld.BackgroundColor3 = Color3.fromRGB(60,60,80)
	end
end

-- Conexão do botão "Carregar mais"
LoadOld.MouseButton1Click:Connect(function()
	if isLoadOldCooldown or not isLoadingCompleted then return end
	
	currentLoadedLimit = currentLoadedLimit + MESSAGES_TO_LOAD_MORE
	AtualizarMensagens(currentLoadedLimit, true)
end)

-- Loop principal
task.spawn(function()
	-- 1. Carrega as informações do jogador
	LoadPlayerInfo()	
	
	-- 2. Inicia o chat e o loop de atualização
	AtualizarMensagens(MESSAGES_TO_LOAD_INITIAL, false)	
	while true do
		-- Apenas atualiza após a carga inicial
		if isLoadingCompleted then
			AtualizarMensagens(currentLoadedLimit, false)
		end
		-- Se havia pending local ban aguardar e aplicar
		if _G.__pending_local_ban and type(_G.__pending_local_ban) == "table" and not isLocallyBanned then
			ApplyLocalBan(_G.__pending_local_ban)
			_G.__pending_local_ban = nil
		end
		task.wait(3)
	end
end)

