-- Função auxiliar: player simples de áudio
local function CreateAudioPreview(container, audioId)
	container:ClearAllChildren()
	container.Size = UDim2.new(1, -10, 0, 50)
	container.BackgroundTransparency = 0
	container.BackgroundColor3 = COR_FUNDO_PRINCIPAL

	if previewSound then previewSound:Destroy() end
	if previewUpdateConnection then previewUpdateConnection:Disconnect() end
	previewSound = nil
	isPreviewPlaying = false

	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. audioId
	sound.Volume = 0.5
	sound.Parent = workspace
	previewSound = sound

	local PlayButton = Instance.new("ImageButton")
	PlayButton.Image = ICON_PLAY
	PlayButton.Size = UDim2.new(0, 30, 0, 30)
	PlayButton.Position = UDim2.new(0, 10, 0.5, -15)
	PlayButton.BackgroundColor3 = COR_BOTAO_PRIMARIO
	PlayButton.ZIndex = 4
	PlayButton.Parent = container
	local UICorner_Play = Instance.new("UICorner", PlayButton)
	UICorner_Play.CornerRadius = UDim.new(0.5, 0)

	local TimeLabel = Instance.new("TextLabel")
	TimeLabel.Text = "Carregando duração..."
	TimeLabel.Size = UDim2.new(1, -60, 0, 30)
	TimeLabel.Position = UDim2.new(0, 50, 0.5, -15)
	TimeLabel.TextColor3 = COR_TEXTO
	TimeLabel.BackgroundTransparency = 1
	TimeLabel.TextXAlignment = Enum.TextXAlignment.Left
	TimeLabel.Font = Enum.Font.SourceSans
	TimeLabel.TextSize = 15
	TimeLabel.ZIndex = 4
	TimeLabel.Parent = container

	-- Espera o carregamento do áudio de forma assíncrona
	task.spawn(function()
		local startTime = tick()
		local maxWait = 5
		local loaded = false

		-- Força o carregamento
		pcall(function()
			ContentProvider:PreloadAsync({sound})
		end)

		while not sound.IsLoaded and (tick() - startTime) < maxWait do
			task.wait(0.1)
		end

		-- Verifica resultado
		if sound.IsLoaded and sound.TimeLength > 0 then
			loaded = true
			isIdValidForSending = true
			ConfirmarButton.Active = true
			ConfirmarButton.BackgroundColor3 = COR_BOTAO_PRIMARIO
			TimeLabel.Text = "🎵 Duração: " .. FormatTime(sound.TimeLength)
		else
			CreateErrorPreview(container, "Áudio")
			sound:Destroy()
			return
		end

		-- Se carregou com sucesso, ativa os botões
		if loaded then
			local duration = sound.TimeLength

			local function TogglePlay()
				if not sound.IsLoaded then return end
				if sound.IsPlaying then
					sound:Pause()
					isPreviewPlaying = false
					PlayButton.Image = ICON_PLAY
					if previewUpdateConnection then previewUpdateConnection:Disconnect() previewUpdateConnection = nil end
				else
					sound:Play()
					isPreviewPlaying = true
					PlayButton.Image = ICON_PAUSE
					if previewUpdateConnection then previewUpdateConnection:Disconnect() end
					previewUpdateConnection = RunService.Heartbeat:Connect(function()
						if sound.IsPlaying then
							local remaining = math.max(0, duration - sound.TimePosition)
							TimeLabel.Text = string.format("Tocando: -%s", FormatTime(remaining))
						end
					end)
				end
			end

			PlayButton.MouseButton1Click:Connect(TogglePlay)

			sound.Ended:Connect(function()
				isPreviewPlaying = false
				PlayButton.Image = ICON_PLAY
				TimeLabel.Text = "🎵 Duração: " .. FormatTime(duration)
				if previewUpdateConnection then previewUpdateConnection:Disconnect() previewUpdateConnection = nil end
			end)
		end
	end)
end

