                            table.insert(allSubtitles, item)
                        end
                    elseif item:IsA("TextBox") then
                        table.insert(allTextBoxes, item)
                    end
                end
            end
        end

        if #allSubtitles < 4 or #allTextBoxes < 4 then
            warn("Erro ao mapear elementos de duração. A estrutura do painel pode ter mudado.")
            return
        end
        
        local subtitlesTempo = {allSubtitles[1], allSubtitles[2], allSubtitles[3]} 
        local boxesTempo = {allTextBoxes[1], allTextBoxes[2], allTextBoxes[3]}   
        local motivoSubtitulo = allSubtitles[4]
        local boxMotivo = allTextBoxes[4] 

