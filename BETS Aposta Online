local function UpdatePreview()
	if previewSound and isPreviewPlaying then
		previewSound:Stop()
	end
	if previewUpdateConnection then previewUpdateConnection:Disconnect() end
	previewSound = nil
	isPreviewPlaying = false

	local text = IdTextBox.Text
	local id = text:gsub("%D", "")

	-- CORREÇÃO 1: Mova a verificação de cache para o topo.
	-- Se o ID não mudou E a validação anterior foi TRUE, retorne IMEDIATAMENTE.
	if id == lastCheckedMediaId and isIdValidForSending then
		PreviewContainer.Visible = true 
		return
	end

	-- Se chegou aqui, o ID é novo OU a validação anterior falhou.
	lastCheckedMediaId = id
	-- FIM CORREÇÃO 1

	-- === CORREÇÃO: Trata ID Vazio (Esconde o painel) ===
	if id == "" then
        isIdValidForSending = false 
        ConfirmarButton.Active = false
        ConfirmarButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
		
        -- Esconde a prévia em vez de mostrar a imagem de erro.
		PreviewContainer.Visible = false
		PreviewContainer:ClearAllChildren()
		return
	end
    -- ======================================================

	-- Se o ID não for vazio, mostra o container e limpa para carregar o novo conteúdo
	PreviewContainer.Visible = true
	PreviewContainer:ClearAllChildren()


    if selectedMediaType == "Imagem" then
        PreviewContainer:ClearAllChildren()
        PreviewContainer.ClipsDescendants = true
        PreviewContainer.BackgroundTransparency = 0
        PreviewContainer.BackgroundColor3 = COR_FUNDO_PRINCIPAL
        PreviewContainer.Size = UDim2.new(0, 220, 0, 220)
        PreviewContainer.AnchorPoint = Vector2.new(0.5, 0.5)
        PreviewContainer.Position = UDim2.new(0.5, 0, 0.5, 0)

        -- Cria a área da imagem centralizada
        local imageHolder = Instance.new("Frame")
        imageHolder.Size = UDim2.new(1, -20, 1, -40)
        imageHolder.Position = UDim2.new(0.5, 0, 0.5, -10)
        imageHolder.AnchorPoint = Vector2.new(0.5, 0.5)
        imageHolder.BackgroundColor3 = COR_SUPERFICIE
        imageHolder.Parent = PreviewContainer

        local imageLabel = Instance.new("ImageLabel")
        imageLabel.Size = UDim2.new(1, 0, 1, 0)
        imageLabel.BackgroundTransparency = 1
        imageLabel.ScaleType = Enum.ScaleType.Fit
        imageLabel.Image = "rbxassetid://" .. id
        imageLabel.ZIndex = 4
        imageLabel.Parent = imageHolder

        local UICorner_Img = Instance.new("UICorner")
        UICorner_Img.CornerRadius = UDim.new(0, 10)
        UICorner_Img.Parent = imageHolder

        -- Texto de carregamento centralizado
        local loadingLabel = Instance.new("TextLabel")
        loadingLabel.Size = UDim2.new(1, 0, 0, 30)
        loadingLabel.Position = UDim2.new(0.5, 0, 1, -10)
        loadingLabel.AnchorPoint = Vector2.new(0.5, 1)
        loadingLabel.Text = "Carregando imagem..."
        loadingLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        loadingLabel.BackgroundTransparency = 1
        loadingLabel.Font = Enum.Font.SourceSans
        loadingLabel.TextSize = 16
        loadingLabel.ZIndex = 4
        loadingLabel.Parent = PreviewContainer

        -- Validação assíncrona (aguarda carregamento)
        task.spawn(function()
            local startTime = tick()
            local timeout = 5
            local valid = false

            while not imageLabel.IsLoaded and (tick() - startTime) < timeout do
                task.wait(0.1)
            end
            
            -- CORREÇÃO 2: Evita que um resultado de validação antigo sobrescreva o novo.
            if id ~= lastCheckedMediaId then return end 

            if imageLabel.IsLoaded then
                valid = true
            end

            loadingLabel:Destroy()

            if valid then
                -- Imagem carregou corretamente
                isIdValidForSending = true
                ConfirmarButton.Active = true
                ConfirmarButton.BackgroundColor3 = COR_BOTAO_PRIMARIO
            else
                -- Imagem inválida, substitui por fallback
                imageLabel.Image = INVALID_ASSET_IMAGE_ID
                isIdValidForSending = false
                ConfirmarButton.Active = false
                ConfirmarButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
            end
        end)

    elseif selectedMediaType == "Audio" then
        -- O reset síncrono agora só acontece porque a Verificação de Cache (CORREÇÃO 1)
        -- já impediu que essa parte fosse alcançada se o ID já estivesse válido.
        lastInputAudioId = id
        isIdValidForSending = false
        ConfirmarButton.Active = false
        ConfirmarButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)

        CreateAudioPreview(PreviewContainer, id)
    end
end

