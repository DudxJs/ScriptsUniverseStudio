-- FUNÇÃO PARA LER CÉLULAS (GET - Não precisa de API_KEY na URL)
local function LerCelula(sheetName, startRow, startCol, numRows, numCols)
	numRows = numRows or 1
	numCols = numCols or 1
	
	local query = {
		pagina = "Celulas",	
		sheet = sheetName,
		startRow = startRow,
		startCol = startCol,
		numRows = numRows,
		numCols = numCols
	}
	
	local queryString = {}
	for k, v in pairs(query) do
		table.insert(queryString, string.format("%s=%s", k, HttpService:UrlEncode(tostring(v))))
	end
	local finalUrl = url .. "?" .. table.concat(queryString, "&")
	
	local success, response = pcall(function()
		return http_request({ Url = finalUrl, Method = "GET" })
	end)
	
	if success and response and response.Body then
		local result = HttpService:JSONDecode(response.Body)
		if result and result.success then return result.values end
	end
	return nil
end

-- FUNÇÃO PARA ESCREVER CÉLULAS (POST - Requer API_KEY no corpo - GARANTE SOBRESCRITA)
local function EscreverCelula(sheetName, startRow, startCol, values)
	if not values or #values == 0 then return false end

	local payload = {
		pagina = "Celulas",	
		sheet = sheetName,
		startRow = startRow,
		startCol = startCol,
		values = values,
		apikey = API_KEY	
	}

	local success, response = pcall(function()
		return http_request({
			Url = url,
			Method = "POST",
			Headers = {["Content-Type"] = "application/json"},
			Body = HttpService:JSONEncode(payload)
		})
	end)
	
	if success and response and response.Body then
		local result = HttpService:JSONDecode(response.Body)
		return result and result.success or false
	end
	return false
end

