local function ProcessarComando(msg)
	if comandosExecutados[msg.ID] then return end	

	local timestampMsg = tonumber(msg.Timestamp) or 0
	local diff = os.time() - timestampMsg
	if diff > 30 then return end

	local texto = msg.Mensagem:gsub("^%s+", "")	
	if texto:sub(1,1) == "/" then
		local partes = {}
		for part in texto:gmatch("[^%s]+") do table.insert(partes, part) end
		
		local comandoNome = partes[1]:lower()
		local args = {}
		for i = 2, #partes do table.insert(args, partes[i]) end

		if comandos[comandoNome] then
			local requiredClass = NIVEIS_COMANDO[comandoNome] or "DEFAULT"
			
			if msg.Player:lower() == LocalPlayer.Name:lower() and not IsPermissionSufficient(requiredClass) then
				warn(string.format("NEGADO: Comando %s ignorado no log. Permissão insuficiente.", comandoNome))	
				return	
			end
			
			comandosExecutados[msg.ID] = true
			comandos[comandoNome](msg, args)	
		end
	end
end

