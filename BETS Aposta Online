        local corOriginalSubtitulo = Color3.fromRGB(220, 220, 220) 
        local corOriginalTextBox = Color3.fromRGB(255, 255, 255) 
        
        local corMotivoObrigatorio = Color3.fromRGB(255, 100, 100)
        local placeholderMotivoObrigatorio = "Motivo Obrigatório"

        -- 1. BLOQUEIO/DESBLOQUEIO DOS CAMPOS DE TEMPO (O clique volta a ser bloqueado aqui)
        for _, sub in ipairs(subtitlesTempo) do
            sub.TextColor3 = deveBloquearTempo and COR_BLOQUEADA or corOriginalSubtitulo
        end
        
        for i, box in ipairs(boxesTempo) do
            
            -- CHAVE DA CORREÇÃO: Encontra o Hitbox e ativa-o para bloquear o clique/toque
            local Hitbox = box.Parent:FindFirstChild("Hitbox")
            if Hitbox and Hitbox:IsA("TextButton") then
                Hitbox.Active = deveBloquearTempo -- Ativa/Desativa o bloqueador de clique (ZIndex 20)
            end
            
            -- Bloqueio de input de texto e seleção (segurança extra)
            box.TextEditable = not deveBloquearTempo 
            box.Selectable = not deveBloquearTempo
            
            -- Controle Visual
            box.TextColor3 = deveBloquearTempo and COR_BLOQUEADA or corOriginalTextBox
            box.PlaceholderColor3 = deveBloquearTempo and COR_BLOQUEADA or corOriginalTextBox
            
            if deveBloquearTempo then
                box.Text = "" 
            end
        end
        
        -- 2. MOTIVO (Torna Obrigatório quando Permanente e muda cor - SEM BLOQUEAR INTERAÇÃO)
        if deveBloquearTempo then
            boxMotivo.PlaceholderText = placeholderMotivoObrigatorio
            boxMotivo.PlaceholderColor3 = corMotivoObrigatorio
            motivoSubtitulo.TextColor3 = corMotivoObrigatorio 
        else
            boxMotivo.PlaceholderText = "Opcional"
            boxMotivo.PlaceholderColor3 = corOriginalTextBox
            motivoSubtitulo.TextColor3 = corOriginalSubtitulo
        end
        
        -- NOVO: Garante que o Hitbox do Motivo esteja sempre inativo (clicável/editável)
        local HitboxMotivo = boxMotivo.Parent:FindFirstChild("Hitbox")
        if HitboxMotivo and HitboxMotivo:IsA("TextButton") then
            HitboxMotivo.Active = false
        end
        boxMotivo.TextEditable = true
        boxMotivo.Selectable = true
    end
