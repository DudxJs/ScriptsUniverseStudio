	-- VARIÁVEIS DE ESTADO DO PLAYER LOCAL
	local isPlaying = false
	local updateConnection = nil
	local isDragging = false
	local duration = 0
	local isDurationKnown = false

	-- Função para calcular e atualizar a duração
	local function UpdateDuration(sound)
		if sound.IsLoaded and sound.TimeLength > 0 then
			duration = sound.TimeLength
			TimeLabel.Text = FormatTime(duration) -- Mostra a duração total
			isDurationKnown = true
		end
	end

	-- Tenta obter a duração imediatamente ou espera o carregamento
	UpdateDuration(audioPlayer)
	audioPlayer.Loaded:Connect(function()
		UpdateDuration(audioPlayer)
	end)
	
	-- LÓGICA DE UPDATE DE PROGRESSO (Heartbeat Loop)
	local function UpdateProgress()
		if isDragging or not audioPlayer.IsPlaying or not isDurationKnown then return end
		
		local currentTime = audioPlayer.TimePosition
		local progress = currentTime / duration
		
		-- Atualiza Barra de Preenchimento
		ProgressFill.Size = UDim2.new(progress, 0, 1, 0)
		
		-- Atualiza Handle (Bolinha)
		SeekHandle.Position = UDim2.new(progress, -5, 0.5, -5)
		
		-- Atualiza Tempo Restante (contagem decrescente)
		local remainingTime = math.max(0, duration - currentTime)
		TimeLabel.Text = "-" .. FormatTime(remainingTime)
	end
	
	-- LÓGICA DE PLAY/PAUSE
	local isStopCooldown = false

	local function StopCurrentPlaying()
		if isStopCooldown then return end
		isStopCooldown = true

		if currentPlayingSound and currentPlayingSound.Parent then
			local oldPlayerFrame = currentPlayingSound.Parent:FindFirstAncestor("AudioPlayerFrame")
			if oldPlayerFrame then
				local oldButton = oldPlayerFrame:FindFirstChild("PlayPauseButton")
				local oldProgress = oldPlayerFrame:FindFirstDescendant("ProgressFill")
				local oldHandle = oldPlayerFrame:FindFirstDescendant("SeekHandle")
				local oldTime = oldPlayerFrame:FindFirstDescendant("TimeLabel")

				if oldButton then oldButton.Image = ICON_PLAY end
				if oldProgress then oldProgress.Size = UDim2.new(0,0,1,0) end
				if oldHandle then oldHandle.Position = UDim2.new(0,-5,0.5,-5) end
				if oldTime then 
					-- Tenta recalcular a duração total para resetar o tempo
					if oldTime.Text:match("^%-") then
						local oldPlayer = currentPlayingSound
						if oldPlayer.IsLoaded and oldPlayer.TimeLength > 0 then
							oldTime.Text = FormatTime(oldPlayer.TimeLength)
						else
							oldTime.Text = "0:00"
						end
					end
				end
			end

			currentPlayingSound:Stop()
			currentPlayingSound.TimePosition = 0
		end
		currentPlayingSound = nil

		task.delay(0.3, function() isStopCooldown = false end)
	end

	local function TogglePlayback()
		if not isDurationKnown then return end

		-- 🚫 Impede dois áudios ao mesmo tempo
		if currentPlayingSound and currentPlayingSound ~= audioPlayer and currentPlayingSound.IsPlaying then
			StopCurrentPlaying() -- Reseta o outro antes
		end

		if audioPlayer.IsPlaying then
			audioPlayer:Pause()
			isPlaying = false
			PlayPauseButton.Image = ICON_PLAY
			if updateConnection then updateConnection:Disconnect() updateConnection = nil end
			if currentPlayingSound == audioPlayer then currentPlayingSound = nil end
		else
			audioPlayer:Play()
			isPlaying = true
			currentPlayingSound = audioPlayer
			PlayPauseButton.Image = ICON_PAUSE

			if updateConnection then updateConnection:Disconnect() end
			updateConnection = RunService.Heartbeat:Connect(UpdateProgress)
		end
	end

	PlayPauseButton.MouseButton1Click:Connect(TogglePlayback)
	
	-- FIM DO ÁUDIO: RESET
	audioPlayer.Ended:Connect(function()
		isPlaying = false
		PlayPauseButton.Image = ICON_PLAY -- Ícone Play
		ProgressFill.Size = UDim2.new(0, 0, 1, 0)
		SeekHandle.Position = UDim2.new(0, -5, 0.5, -5)
		TimeLabel.Text = FormatTime(duration)
		audioPlayer.TimePosition = 0 -- Garante reset após o fim
		
		if updateConnection then updateConnection:Disconnect() end
		if currentPlayingSound == audioPlayer then currentPlayingSound = nil end
	end)
	
	-- LÓGICA DE SEEKING (Mouse/Touch na Barra de Progresso)
	local function OnDrag(input)
		if not isDragging or not isDurationKnown then return end
		
		-- Usa a posição absoluta do input e subtrai a posição absoluta da barra de progresso.
		local relativeX = math.clamp(input.Position.X - ProgressLine.AbsolutePosition.X, 0, ProgressLine.AbsoluteSize.X)
		local progress = relativeX / ProgressLine.AbsoluteSize.X
		
		-- Atualiza UI durante o drag
		ProgressFill.Size = UDim2.new(progress, 0, 1, 0)
		SeekHandle.Position = UDim2.new(progress, -5, 0.5, -5)
		
		-- Atualiza o tempo no label (para feedback imediato)
		local newTimePosition = progress * duration
		local remainingTime = math.max(0, duration - newTimePosition)
		TimeLabel.Text = "-" .. FormatTime(remainingTime)
	end

	local function OnSeekEnd(input)
		if not isDragging or not isDurationKnown then return end
		isDragging = false

		local relativeX = math.clamp(input.Position.X - ProgressLine.AbsolutePosition.X, 0, ProgressLine.AbsoluteSize.X)
		local progress = relativeX / ProgressLine.AbsoluteSize.X
		local newTimePosition = progress * duration

		audioPlayer.TimePosition = newTimePosition -- MOVE o som

		-- ⚙️ SINCRONIZA: reinicia o loop de atualização
		if updateConnection then updateConnection:Disconnect() end
		updateConnection = RunService.Heartbeat:Connect(UpdateProgress)

		-- 🔁 Se o áudio estava tocando, retoma do novo ponto
		if isPlaying then
			audioPlayer:Play()
		end
	end
	
	local function OnSeekStart(input)
		-- ESSENCIAL: Garante que apenas clique ou toque inicie o drag
		if not isDurationKnown or not (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then return end
		
		-- 🚫 Impede interação se outro áudio estiver tocando
		if currentPlayingSound and currentPlayingSound ~= audioPlayer and currentPlayingSound.IsPlaying then
			warn("[Bloqueado] Outro áudio está tocando. Aguarde ele parar antes de mover este.")
			return
		end
		
		isDragging = true
		if updateConnection then updateConnection:Disconnect() end -- Pausa o update automático durante o drag
		
		OnDrag(input) -- Executa a primeira atualização para mover o handle para onde o usuário clicou
	end
	
	-- Conexões de Input para a LINHA inteira (mais fácil de tocar/clicar)
	ProgressBarContainer.InputBegan:Connect(OnSeekStart)
	ProgressBarContainer.InputChanged:Connect(function(input)
		if isDragging then OnDrag(input) end
	end)
	ProgressBarContainer.InputEnded:Connect(function(input)
		if isDragging then OnSeekEnd(input) end
	end)

	-- Permite drag/click no Handle também
	SeekHandle.InputBegan:Connect(OnSeekStart)
	SeekHandle.InputChanged:Connect(function(input)
		if isDragging then OnDrag(input) end
	end)
	SeekHandle.InputEnded:Connect(function(input)
		if isDragging then OnSeekEnd(input) end
	end)
	
	-- AQUI: ADICIONA O BOTÃO RESPONDER ABAIXO DO PLAYER DE ÁUDIO
	contentHeight = CreateResponderButton(mediaContentFrame, msg, tipo, contentHeight)

