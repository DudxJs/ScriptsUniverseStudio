-- [[ FUNÇÃO DE REQUISIÇÃO HTTP ]]
local function http_request(options)
	local responseData = nil
	local success, response = pcall(function()
		if HttpService.RequestAsync then
			responseData = HttpService:RequestAsync(options)
			return responseData.Success and responseData
		end
		-- Fallback for older or exploited environments
		if options.Method == "GET" then
			local body = HttpService:GetAsync(options.Url)
			return {Success = true, Body = body}
		elseif options.Method == "POST" and options.Body then
			local body = HttpService:PostAsync(options.Url, options.Body, Enum.HttpContentType.ApplicationJson)
			return {Success = true, Body = body}
		end
		return nil
	end)
	
	if success and response and (response.Success or response.Body) then
		return response
	else
		return nil
	end
end

