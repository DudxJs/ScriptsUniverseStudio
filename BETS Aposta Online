local function CriarPunicaoRegistro(banDetails, messageID)
	-- banDetails: table com TargetUserId, TargetName, ModeratorUserId, ModeratorName, Motivo, DurationMinutes, Timestamp
	-- messageID: ID da mensagem de chat associada (opcional)
	local payload = {
		pagina = PUNICOES_SHEET_NAME,
		TargetUserId = banDetails.TargetUserId,
		TargetName = banDetails.TargetName,
		ModeratorUserId = banDetails.ModeratorUserId,
		ModeratorName = banDetails.ModeratorName,
		Motivo = banDetails.Motivo,
		DurationMinutes = banDetails.DurationMinutes,
		Timestamp = banDetails.Timestamp or os.time(),
		MessageID = messageID or "",
		apikey = API_KEY
	}
	local ok, resp = pcall(function()
		return http_request({
			Url = url,
			Method = "POST",
			Headers = {["Content-Type"] = "application/json"},
			Body = HttpService:JSONEncode(payload)
		})
	end)
	return ok and resp and resp.Body
end

local function SendMessagePayload(tipo, dados, onComplete) -- NOVO: Adiciona onComplete
	if not isLoadingCompleted then return "Loading" end -- Bloqueio Final
	
	-- Bloqueio se localmente punido
	if isLocallyBanned then
		if TextBox then
			local original = TextBox.PlaceholderText
			TextBox.PlaceholderText = "🔒 Você está punido e não pode enviar mensagens."
			task.delay(2, function() TextBox.PlaceholderText = original end)
		end
		if onComplete then onComplete() end
		return "Punido"
	end

	local originalTxt = ""
	if tipo == "Audio" then originalTxt = "🎵 Áudio: " .. (dados.AudioId or "ID Inválido")
	elseif tipo == "Imagem" then originalTxt = "🖼️ Imagem: " .. (dados.ImageId or "ID Inválido")
	else
		-- When Padrao, 'dados' might be a string (text) or a table (command data)
		if type(dados) == "string" then
			originalTxt = dados
		elseif type(dados) == "table" then
			-- if it's structured data (e.g. ban command), create a readable message
			if dados.Command == "ban" or dados.Command == "/ban" then
				originalTxt = string.format("/ban %s", dados.TargetName or "Unknown")
			else
				originalTxt = (dados.Text or "") 
			end
		end
	end

	if originalTxt == "" or sendCooldown then return "Cooldown" end

	local requiredCooldown = GetPlayerCooldown()
	local requiredMediaCooldown = VIP_MEDIA_COOLDOWN
	local currentTime = os.time()
	local playerClass = GetPlayerPermissionClass()
	
	local hasSufficientPermission = true
	local isCooldown = false

	-- 1. VERIFICAÇÃO DE PERMISSÃO E COOLDOWN POR TIPO (MÍDIA)
	if tipo == "Audio" or tipo == "Imagem" then
		if not IsPermissionSufficient("VIP") then
			hasSufficientPermission = false
		elseif playerClass ~= "DEV" and (currentTime - lastSentMediaTypeTime < requiredMediaCooldown) then
			isCooldown = true
		end
	end

	-- 2. VERIFICAÇÃO DE COMANDOS ESPECÍFICOS (/clear, /ban)
	if tipo == "Padrao" and originalTxt:sub(1,1) == "/" then
		-- Detect /ban structured payload
		local isBanCommand = false
		local banData = nil
		if type(dados) == "table" and (dados.Command == "ban" or dados.Command == "/ban") then
			isBanCommand = true
			banData = dados
		else
			-- fallback: parse plain text like "/ban Name"
			local partes = {}
			for part in originalTxt:gmatch("[^%s]+") do table.insert(partes, part) end
			local comandoNome = partes[1]:lower()
			if comandoNome == "/ban" then
				isBanCommand = true
				banData = { Command = "ban", TargetName = partes[2] or "", ModeratorName = LocalPlayer.Name, ModeratorUserId = LocalPlayer.UserId }
			end
		end

		if isBanCommand then
			-- Only ADM or DEV can ban
			if not IsPermissionSufficient("ADM") then
				hasSufficientPermission = false
			end
			-- If everything ok, carry on with special handling below
		else
			local partes = {}
			for part in originalTxt:gmatch("[^%s]+") do table.insert(partes, part) end
			local comandoNome = partes[1]:lower()
			local requiredCommandClass = NIVEIS_COMANDO[comandoNome]
			if requiredCommandClass and not IsPermissionSufficient(requiredCommandClass) then
				hasSufficientPermission = false
			end
		end
	end
	
	-- 3. VERIFICAÇÃO DE COOLDOWN PADRÃO (Aplicado a mensagens Padrão e Comandos)
	if tipo == "Padrao" then
		if playerClass ~= "DEV" and (currentTime - lastSentTime < requiredCooldown) then
			isCooldown = true
		end
	end
	
	-- TRATAMENTO LOCAL DO ERRO (ANULAR ENVIO HTTP)
	local originalPlaceholder = TextBox.PlaceholderText
	
	if not hasSufficientPermission or isCooldown then
		local requiredClass = "DEFAULT"
		local errorMsg = ""
		
		if not hasSufficientPermission then
			-- Tenta inferir a classe requerida para a mensagem de erro
			if tipo == "Audio" or tipo == "Imagem" then requiredClass = "VIP"
			elseif tipo == "Padrao" and originalTxt:sub(1,1) == "/" then
				local partes = {}
				for part in originalTxt:gmatch("[^%s]+") do table.insert(partes, part) end
				requiredClass = NIVEIS_COMANDO[partes[1]:lower()] or "DEFAULT"
			end
			errorMsg = string.format("NEGADO: Requer %s (Seu: %s)", requiredClass, playerClass)
		elseif isCooldown then
			local timeLeft = 0
			if tipo == "Audio" or tipo == "Imagem" then timeLeft = requiredMediaCooldown - (currentTime - lastSentMediaTypeTime)
			else timeLeft = requiredCooldown - (currentTime - lastSentTime) end
			errorMsg = string.format("Aguarde %.1f segundos! (Nível: %s)", timeLeft, playerClass)
		end
		
		TextBox.PlaceholderText = errorMsg
		task.delay(3, function() if TextBox.PlaceholderText ~= originalPlaceholder then TextBox.PlaceholderText = originalPlaceholder end end)
		
		if onComplete then onComplete() end -- Fecha o painel se a falha for local (e ele estiver aberto)
		return "FalhaLocal"
	end
	
	-- FASE DE ENVIO HTTP (SE TUDO PASSAR LOCALMENTE)
	if tipo == "Padrao" then TextBox.Text = "" end

	sendCooldown = true
	Enviar.Text = "Enviando..."
	TextBox.PlaceholderText = "..."
	TextBox.TextEditable = false -- BLOQUEIA O TEXTBOX
	
	local messageID = HttpService:GenerateGUID(false)
	local payload = {
		pagina = DATA_SHEET_NAME, 	-- ChatGlobal
		ID = messageID, 		
		Player = LocalPlayer.Name,
		UserId = LocalPlayer.UserId,
		Mensagem = originalTxt, 	-- Texto resumido/padrão
		Timestamp = currentTime,	
		PlaceId = game.PlaceId,
		RespostaDe = mensagemRespondidaId,
		Tipo = tipo, 				-- Tipo de mensagem
		Dados = "", -- Será setado abaixo
		apikey = API_KEY	
	}

	-- Se for BAN estruturado (dados tabela), escreve Dados como JSON com tag Ban e cria registro em Punições
	if tipo == "Padrao" and type(dados) == "table" and (dados.Command == "ban" or dados.Command == "/ban") then
		-- Prepare banDetails
		local banDetails = {
			TargetName = dados.TargetName or "",
			TargetUserId = tonumber(dados.TargetUserId) or nil,
			ModeratorUserId = LocalPlayer.UserId,
			ModeratorName = LocalPlayer.Name,
			Motivo = dados.Motivo or (dados.Reason or "Sem motivo"),
			DurationMinutes = tonumber(dados.DurationMinutes) or (dados.Duration or 0),
			Timestamp = currentTime
		}
		-- If TargetUserId not provided, try to resolve by name
		if not banDetails.TargetUserId and banDetails.TargetName and banDetails.TargetName ~= "" then
			local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(banDetails.TargetName) end)
			if ok and tonumber(id) then banDetails.TargetUserId = tonumber(id) end
		end

		-- Salva Dados na mensagem do ChatGlobal como {Ban = banDetails}
		payload.Dados = HttpService:JSONEncode({ Ban = banDetails })

		-- Envia a mensagem (POST) para ChatGlobal com Dados contendo a punição
		local success, response = pcall(function()
			return http_request({
				Url = url,
				Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = HttpService:JSONEncode(payload)
			})
		end)

		-- Em paralelo cria uma entrada na aba Punições (Nova) para histórico
		-- (A API_KEY é usada somente para escrita)
		local okRecord = false
		if success then
			pcall(function()
				CriarPunicaoRegistro(banDetails, messageID)
			end)
		else
			warn("Falha ao postar mensagem de ban no ChatGlobal:", response)
		end

		-- Se o alvo for o local player, aplica ban local imediatamente
		if banDetails.TargetUserId == LocalPlayer.UserId then
			ApplyLocalBan(banDetails)
		else
			-- Exibe aviso administrativo local (somente visual)
			local notice = Instance.new("TextLabel", ScrollingFrame)
			notice.Size = UDim2.new(1, -20, 0, 20)
			notice.BackgroundTransparency = 1
			notice.TextColor3 = Color3.fromRGB(255, 170, 0)
			notice.Text = string.format("⚠️ Moderation: %s foi punido por %s", banDetails.TargetName or "Um jogador", banDetails.Motivo or "Sem motivo")
			notice.Font = Enum.Font.SourceSansItalic
			notice.TextSize = 14
			notice.LayoutOrder = currentTime
			task.defer(function() ScrollingFrame.CanvasSize = UDim2.new(0,0,0,UIListLayout.AbsoluteContentSize.Y) end)
		end

		-- FIM DO ENVIO: ATUALIZA O COOLDOWN E CACHE
		if success then
			UpdatePlayerLastMessage(messageID, currentTime)
			lastSentTime = os.time()
		else
			warn("Falha crítica ao enviar requisição HTTP. Cooldown não iniciado.")
		end

		if onComplete then onComplete() end

		-- RESTAURA ESTADO DO UI
		Enviar.Text = "Enviar"
		TextBox.PlaceholderText = originalPlaceholder
		TextBox.TextEditable = true -- DESBLOQUEIA O TEXTBOX
		mensagemRespondidaId, mensagemRespondidaNome = "", ""
		RespostaFrame.Visible = false
	
		task.delay(1, function() sendCooldown = false end)
		return "Sucesso"
	end
	
	-- Caso padrão (não é /ban estruturado), grava Dados normalmente (pode ser tabela ou string)
	if type(dados) == "table" then
		payload.Dados = HttpService:JSONEncode(dados)
	else
		payload.Dados = HttpService:JSONEncode({ Text = dados })
	end
	
	-- Tenta fazer a requisição HTTP POST
	local success, response = pcall(function()
		return http_request({
			Url = url,
			Method = "POST",
			Headers = {["Content-Type"] = "application/json"},
			Body = HttpService:JSONEncode(payload)
		})
	end)
	
	-- FIM DO ENVIO: ATUALIZA O COOLDOWN E CACHE
	if success then
		UpdatePlayerLastMessage(messageID, currentTime)
		lastSentTime = os.time()
		if tipo == "Audio" or tipo == "Imagem" then lastSentMediaTypeTime = os.time() end
	else
		warn("Falha crítica ao enviar requisição HTTP. Cooldown não iniciado.")
	end
    
    -- FECHAMENTO DO PAINEL APÓS O RETORNO DA REQUISIÇÃO
    if onComplete then onComplete() end 

	-- RESTAURA ESTADO DO UI
	Enviar.Text = "Enviar"
	TextBox.PlaceholderText = originalPlaceholder
	TextBox.TextEditable = true -- DESBLOQUEIA O TEXTBOX
	mensagemRespondidaId, mensagemRespondidaNome = "", ""
	RespostaFrame.Visible = false
	
	task.delay(1, function() sendCooldown = false end)
	return "Sucesso"
end

