    -- ==========================================================
    local function AtualizarEstadoDuracao(painelFrame, deveBloquearTempo)
        
        local allSubtitles = {}
        local allTextBoxes = {}
        
        -- Mapeamento dos elementos (lógica mantida)
        for _, childFrame in ipairs(painelFrame:GetChildren()) do
            if childFrame:IsA("Frame") and childFrame.LayoutOrder > 0 then
                for _, item in ipairs(childFrame:GetDescendants()) do
