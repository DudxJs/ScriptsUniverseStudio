-- ajuste fino vertical (troque -2 por -3 / -4 / -1 conforme precisar)
local verticalAdjust = 0.3

local function UpdateClassIconPosition()
    -- proteção básica
    if not nome or not nome.Parent or not contentWrapper or not contentWrapper.Parent then return end

    -- pega as posições absolutas
    local nomeAbsPos = nome.AbsolutePosition
    local wrapperAbsPos = contentWrapper.AbsolutePosition

    -- pega larguras / alturas
    local textWidth = 0
    pcall(function() textWidth = nome.TextBounds.X end)

    local nomeAbsSizeY = nome.AbsoluteSize.Y or 18
    local iconHeight = classIcon.Size.Y.Offset or 18

    -- calcula offset dentro do contentWrapper
    local offsetX = (nomeAbsPos.X - wrapperAbsPos.X) + textWidth + 6   -- 6px de espaçamento
    local offsetY = (nomeAbsPos.Y - wrapperAbsPos.Y) + math.floor((nomeAbsSizeY - iconHeight)/2) + verticalAdjust

    -- aplica (usa math.floor para evitar subpixel)
    classIcon.Position = UDim2.new(0, math.floor(offsetX), 0, math.floor(offsetY))
end

